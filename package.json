    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "mapshaper": "^0.7.88",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "engines": {
