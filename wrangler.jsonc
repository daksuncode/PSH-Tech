{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psh-tech",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The built app in ./dist. Only /api/* runs the Worker code first;
  // everything else is served straight from the assets (SPA fallback).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CLAUDE_MODEL": "claude-opus-5-5"
  },
  // One data point per API request; queried by monitoring/ (Grafana).
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "psh_api_metrics" }],
  // Per-IP limit for the AI routes: 10 requests per 60 s per route.
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
